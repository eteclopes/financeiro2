# Copie para .env e preencha. Nunca versione o .env real.

# Runtime: Transaction Pooler do Supabase (porta 6543).
DATABASE_URL="postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma Migrate: conexão direta ou Session Pooler (porta 5432).
DIRECT_URL="postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-0-REGION.pooler.supabase.com:5432/postgres"

PORT=3333
NODE_ENV=development
APP_TIME_ZONE="America/Sao_Paulo"
APP_LOCALE="pt-BR"
APP_CURRENCY="BRL"

# Lista explícita, separada por vírgulas. Sem barra no final.
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,https://seu-frontend.vercel.app,https://seu-admin.vercel.app"
# Use previews apenas contra staging. Em produção mantenha false.
CORS_ALLOW_PREVIEWS=false
CORS_VERCEL_PROJECT=""
CORS_VERCEL_TEAM=""

JWT_ACCESS_SECRET="gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_ISSUER="financehub-api"
JWT_AUDIENCE="financehub-web"
JWT_ADMIN_AUDIENCE="financehub-admin"
JWT_REFRESH_EXPIRES_IN_DAYS=30
PASSWORD_RESET_EXPIRES_IN_HOURS=1

FRONTEND_URL="http://localhost:5173"
ADMIN_FRONTEND_URL="http://localhost:5174"

# Em desenvolvimento, sem SMTP, o token de recuperação é devolvido apenas
# para teste. Em produção, /forgot-password responde 503 se o provedor não
# estiver configurado ou se a entrega falhar; nunca finge que enviou.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="FinançasPro <no-reply@seu-dominio.com>"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_LIFETIME_PRICE_ID=""
STRIPE_API_BASE="https://api.stripe.com"
STRIPE_API_VERSION="2026-06-24.dahlia"
PRO_LIFETIME_PRICE_LABEL="Oferta vitalícia"

# Usadas somente por npm run seed:admin.
ADMIN_NAME="Administrador"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Conta Pro de teste local/staging. Não existe senha padrão no código.
PRO_TEST_NAME="Conta Pro Teste"
PRO_TEST_EMAIL="teste.pro@financehub.local"
PRO_TEST_PASSWORD=""
ALLOW_PRO_TEST_ACCOUNT=false
