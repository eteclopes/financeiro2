// ============================================================
// SISTEMA DE GESTAO FINANCEIRA PESSOAL INTELIGENTE
// schema.prisma — Etapa 4
// Mapeado 1:1 para database.sql (mesmos nomes de tabela/coluna via @@map/@map)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------- ENUMS ----------------

enum PaymentMethod {
  cash
  pix
  debit
  credit
  transfer
}


enum IncomeOrigin {
  digital
  physical
}

enum CategoryType {
  income
  expense
}

enum MonthStatus {
  open
  closed
}

enum DebtStatus {
  active
  settled
}

enum ExpenseType {
  priority
  fixed
  variable
  card
}

enum ExpenseStatus {
  pending
  partial
  paid
  late
  settled
  /// Parcela de dívida flexível: a obrigação DAQUELE mês foi cumprida mesmo
  /// tendo sido paga abaixo do valor estimado. O que faltou vira saldo
  /// residual (`residualAmount`) e é somado à parcela seguinte. Sai das
  /// pendências do mês; não é atraso.
  flex_paid
}

enum CardInvoiceStatus {
  open
  closed
  paid
}

enum SavingsType {
  deposit
  withdraw
}

enum SavingsOrigin {
  balance
  external
}

enum SavingsBucketKind {
  general
  emergency
  travel
  home
  education
  vehicle
  custom
}

enum GoalStatus {
  active
  completed
  cancelled
}

enum GoalContributionType {
  contribution
  refund
}

enum AlertSeverity {
  info
  warning
  critical
}

enum SimulationType {
  pay_debt
  anticipate_installments
  save_monthly
  reduce_category
  increase_income
}

enum PlanTier {
  basic
  pro
}

enum PlanSource {
  basic
  stripe_lifetime
  manual_test
  manual_admin
}

enum UserRole {
  user
  admin
}

enum BillingPurchaseStatus {
  pending
  paid
  failed
  expired
  refunded
}

// ---------------- MODELS ----------------

model User {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(190)
  role         UserRole @default(user)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  plan         PlanTier @default(basic)
  planSource   PlanSource @default(basic) @map("plan_source")
  planGrantedAt DateTime? @map("plan_granted_at")
  planExpiresAt DateTime? @map("plan_expires_at")
  stripeCustomerId String? @unique @map("stripe_customer_id") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  categories         Category[]
  refreshTokens      RefreshToken[]
  passwordResets     PasswordReset[]
  months             Month[]
  incomeTemplates    IncomeTemplate[]
  incomes            Income[]
  fixedExpenseTemplates FixedExpenseTemplate[]
  debts              Debt[]
  cards              Card[]
  cardPurchases      CardPurchase[]
  expenses           Expense[]
  savingsBuckets     SavingsBucket[]
  savingsTransactions SavingsTransaction[]
  goals              Goal[]
  alerts             Alert[]
  financialHealthScores FinancialHealthScore[]
  auditLogs          AuditLog[]
  simulations        Simulation[]
  billingPurchases   BillingPurchase[]
  dashboardPreference DashboardPreference?
  automationSetting  AutomationSetting?

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  /// Todos os tokens derivados de um mesmo login compartilham a família.
  /// Detectar reuso de um token já rotacionado permite revogar a sessão
  /// inteira, em vez de apenas recusar aquela requisição.
  familyId   String    @map("family_id") @db.VarChar(36)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId], map: "refresh_tokens_family_id_idx")
  @@index([userId, revokedAt], map: "refresh_tokens_user_id_revoked_at_idx")
  @@map("refresh_tokens")
}

model PasswordReset {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model Category {
  id        BigInt       @id @default(autoincrement())
  userId    BigInt?      @map("user_id")
  name      String       @db.VarChar(80)
  type      CategoryType
  isDefault Boolean      @default(false) @map("is_default")
  // Orçamento mensal opcional (só faz sentido para categorias de despesa).
  // Null = sem limite definido, comportamento atual preservado.
  monthlyLimit Decimal?  @map("monthly_limit") @db.Decimal(12, 2)
  createdAt DateTime     @default(now()) @map("created_at")

  user                User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomeTemplates     IncomeTemplate[]
  incomes             Income[]
  fixedExpenseTemplates FixedExpenseTemplate[]
  debts               Debt[]
  cardPurchases       CardPurchase[]
  expenses            Expense[]

  @@unique([userId, name, type])
  @@index([type])
  @@map("categories")
}

model Month {
  id        BigInt      @id @default(autoincrement())
  userId    BigInt      @map("user_id")
  month     Int         @db.SmallInt
  year      Int         @db.SmallInt
  status            MonthStatus @default(open)
  closedAt          DateTime?   @map("closed_at")
  financialSnapshot Json?       @map("financial_snapshot")
  snapshotVersion   Int?        @map("snapshot_version") @db.SmallInt
  createdAt         DateTime    @default(now()) @map("created_at")

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomes           Income[]
  expenses          Expense[]
  cardInvoices      CardInvoice[]
  goalContributions GoalContribution[]
  alerts            Alert[]
  financialHealthScore FinancialHealthScore?
  snapshotVersions  MonthSnapshotVersion[]

  @@unique([userId, month, year])
  @@index([userId, status])
  @@map("months")
}

model IncomeTemplate {
  id            BigInt        @id @default(autoincrement())
  userId        BigInt        @map("user_id")
  description   String        @db.VarChar(160)
  value         Decimal       @db.Decimal(12, 2)
  categoryId    BigInt        @map("category_id")
  paymentMethod PaymentMethod @map("payment_method")
  incomeDay     Int           @default(1) @map("income_day") @db.SmallInt
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  incomes  Income[]

  @@map("income_templates")
}

model Income {
  id            BigInt        @id @default(autoincrement())
  userId        BigInt        @map("user_id")
  monthId       BigInt        @map("month_id")
  templateId    BigInt?       @map("template_id")
  description   String        @db.VarChar(160)
  value         Decimal       @db.Decimal(12, 2)
  categoryId    BigInt        @map("category_id")
  paymentMethod PaymentMethod @map("payment_method")
  origin        IncomeOrigin  @default(digital)
  incomeDate    DateTime      @map("income_date") @db.Date
  observation   String?       @db.VarChar(255)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  month    Month           @relation(fields: [monthId], references: [id])
  template IncomeTemplate? @relation(fields: [templateId], references: [id])
  category Category        @relation(fields: [categoryId], references: [id])

  // Proteção de banco contra receita recorrente duplicada no mesmo mês.
  // NULL é distinto de NULL no PostgreSQL, então receitas avulsas
  // (templateId = null) não são afetadas.
  @@unique([templateId, monthId], map: "incomes_template_id_month_id_key")
  @@index([userId, monthId])
  @@index([userId, incomeDate], map: "incomes_user_id_income_date_idx")
  @@map("incomes")
}

model FixedExpenseTemplate {
  id            BigInt        @id @default(autoincrement())
  userId        BigInt        @map("user_id")
  description   String        @db.VarChar(160)
  categoryId    BigInt        @map("category_id")
  value         Decimal       @db.Decimal(12, 2)
  dueDay        Int           @map("due_day") @db.SmallInt
  paymentMethod PaymentMethod @default(transfer) @map("payment_method")
  cardId        BigInt?       @map("card_id")
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category  @relation(fields: [categoryId], references: [id])
  card     Card?     @relation(fields: [cardId], references: [id])
  expenses Expense[]

  @@map("fixed_expense_templates")
}

model Debt {
  id                 BigInt     @id @default(autoincrement())
  userId             BigInt     @map("user_id")
  description        String     @db.VarChar(160)
  categoryId         BigInt     @map("category_id")
  totalValue         Decimal    @map("total_value") @db.Decimal(12, 2)
  installmentsCount  Int        @map("installments_count") @db.SmallInt
  installmentValue   Decimal    @map("installment_value") @db.Decimal(12, 2)
  flexiblePayment    Boolean    @default(false) @map("flexible_payment")
  dueDay             Int        @map("due_day") @db.SmallInt
  status             DebtStatus @default(active)
  remainingBalance   Decimal    @map("remaining_balance") @db.Decimal(12, 2)
  pendingCarryOver   Decimal    @default(0) @map("pending_carry_over") @db.Decimal(12, 2)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category  @relation(fields: [categoryId], references: [id])
  expenses Expense[]

  @@index([userId, status])
  @@map("debts")
}

model Card {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  name        String   @db.VarChar(80)
  color       String   @default("#6366F1") @db.VarChar(20)
  limitValue  Decimal  @map("limit_value") @db.Decimal(12, 2)
  closingDay  Int      @map("closing_day") @db.SmallInt
  dueDay      Int      @map("due_day") @db.SmallInt
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardPurchases CardPurchase[]
  cardInvoices  CardInvoice[]
  fixedExpenseTemplates FixedExpenseTemplate[]

  @@index([userId])
  @@map("cards")
}

model CardPurchase {
  id                BigInt   @id @default(autoincrement())
  userId            BigInt   @map("user_id")
  cardId            BigInt   @map("card_id")
  description       String   @db.VarChar(160)
  categoryId        BigInt   @map("category_id")
  totalValue        Decimal  @map("total_value") @db.Decimal(12, 2)
  installmentsCount Int      @default(1) @map("installments_count") @db.SmallInt
  installmentValue  Decimal  @map("installment_value") @db.Decimal(12, 2)
  purchaseDate      DateTime @map("purchase_date") @db.Date
  createdAt         DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card     Card      @relation(fields: [cardId], references: [id])
  category Category  @relation(fields: [categoryId], references: [id])
  expenses Expense[]

  @@index([cardId])
  @@map("card_purchases")
}

model CardInvoice {
  id              BigInt            @id @default(autoincrement())
  cardId          BigInt            @map("card_id")
  monthId         BigInt            @map("month_id")
  referenceMonth  Int               @map("reference_month") @db.SmallInt
  referenceYear   Int               @map("reference_year") @db.SmallInt
  closingDate     DateTime          @map("closing_date") @db.Date
  dueDate         DateTime          @map("due_date") @db.Date
  totalValue      Decimal           @default(0) @map("total_value") @db.Decimal(12, 2)
  status          CardInvoiceStatus @default(open)
  paidAt          DateTime?         @map("paid_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  card     Card      @relation(fields: [cardId], references: [id])
  month    Month     @relation(fields: [monthId], references: [id])
  expenses Expense[]

  @@unique([cardId, referenceMonth, referenceYear])
  @@map("card_invoices")
}

model Expense {
  id              BigInt        @id @default(autoincrement())
  userId          BigInt        @map("user_id")
  monthId         BigInt        @map("month_id")
  type            ExpenseType
  description     String        @db.VarChar(160)
  categoryId      BigInt        @map("category_id")
  dueDate         DateTime      @map("due_date") @db.Date
  competenceMonth Int?          @map("competence_month") @db.SmallInt
  competenceYear  Int?          @map("competence_year") @db.SmallInt
  value           Decimal       @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)

  /// Saldo residual de uma parcela flexível: o quanto faltou para o valor
  /// estimado. Fica registrado AQUI e é somado à próxima parcela — nunca
  /// reabre esta. O usuário pode quitá-lo depois, voluntariamente.
  residualAmount    Decimal   @default(0) @map("residual_amount") @db.Decimal(12, 2)
  /// Quando o saldo residual foi totalmente quitado.
  residualSettledAt DateTime? @map("residual_settled_at")
  /// Parcela que recebeu este saldo residual (o acréscimo dela).
  carriedToExpenseId BigInt?  @map("carried_to_expense_id")
  paidAt          DateTime?     @map("paid_at") @db.Date
  status          ExpenseStatus @default(pending)
  paymentMethod   PaymentMethod? @map("payment_method")
  fixedTemplateId BigInt?       @map("fixed_template_id")
  debtId          BigInt?       @map("debt_id")
  cardInvoiceId   BigInt?       @map("card_invoice_id")
  cardPurchaseId  BigInt?       @map("card_purchase_id")
  observation     String?       @db.VarChar(255)
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  month         Month                 @relation(fields: [monthId], references: [id])
  category      Category              @relation(fields: [categoryId], references: [id])
  fixedTemplate FixedExpenseTemplate? @relation(fields: [fixedTemplateId], references: [id])
  debt          Debt?                 @relation(fields: [debtId], references: [id])
  cardInvoice   CardInvoice?          @relation(fields: [cardInvoiceId], references: [id])
  cardPurchase  CardPurchase?         @relation(fields: [cardPurchaseId], references: [id])

  @@index([userId, monthId, type])
  @@index([userId, status])
  @@index([cardInvoiceId])
  // `map` reproduz exatamente o nome criado na migration
  // 20260721030000; sem isso o Prisma enxergaria drift de nome.
  @@unique([fixedTemplateId, competenceMonth, competenceYear], map: "expenses_fixed_template_competence_key")
  @@index([userId, paidAt], map: "expenses_user_id_paid_at_idx")
  @@index([debtId, status], map: "expenses_debt_id_status_idx")
  @@map("expenses")
}

model SavingsBucket {
  id          BigInt            @id @default(autoincrement())
  userId      BigInt            @map("user_id")
  kind        SavingsBucketKind @default(general)
  name        String?           @db.VarChar(120)
  targetValue Decimal?          @map("target_value") @db.Decimal(12, 2)
  isDefault   Boolean           @default(false) @map("is_default")
  isArchived  Boolean           @default(false) @map("is_archived")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions SavingsTransaction[]

  @@index([userId, isArchived])
  automationSettings AutomationSetting[]

  @@map("savings_buckets")
}

model SavingsTransaction {
  id              BigInt        @id @default(autoincrement())
  userId          BigInt        @map("user_id")
  bucketId        BigInt        @map("bucket_id")
  type            SavingsType
  value           Decimal       @db.Decimal(12, 2)
  // Só relevante para type=deposit: de onde veio o dinheiro. 'balance' (o
  // padrão, preserva o comportamento de sempre) sai do saldo disponível
  // agora; 'external' é dinheiro que já estava guardado fora do app —
  // só passa a ser rastreado aqui, sem sair de lugar nenhum.
  origin          SavingsOrigin @default(balance)
  transactionDate DateTime      @map("transaction_date") @db.Date
  observation     String?       @db.VarChar(255)
  balanceAfter    Decimal       @map("balance_after") @db.Decimal(12, 2)
  bucketBalanceAfter Decimal    @map("bucket_balance_after") @db.Decimal(12, 2)
  transferId      String?       @map("transfer_id") @db.VarChar(36)
  createdAt       DateTime      @default(now()) @map("created_at")

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucket SavingsBucket @relation(fields: [bucketId], references: [id], onDelete: Restrict)

  // Mantém o índice simples criado na migration inicial e adiciona os
  // compostos usados para extrato global e saldo por caixinha.
  @@index([userId])
  @@index([userId, createdAt])
  @@index([bucketId, createdAt])
  @@index([transferId])
  @@index([userId, transactionDate], map: "savings_transactions_user_id_transaction_date_idx")
  @@map("savings_transactions")
}

model Goal {
  id          BigInt     @id @default(autoincrement())
  userId      BigInt     @map("user_id")
  name        String     @db.VarChar(120)
  description String?    @db.VarChar(255)
  targetValue Decimal    @map("target_value") @db.Decimal(12, 2)
  targetDate  DateTime?  @map("target_date") @db.Date
  status      GoalStatus @default(active)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId])
  @@map("goals")
}

model GoalContribution {
  id               BigInt               @id @default(autoincrement())
  goalId           BigInt               @map("goal_id")
  monthId          BigInt               @map("month_id")
  value            Decimal              @db.Decimal(12, 2)
  type             GoalContributionType @default(contribution)
  contributionDate DateTime             @map("contribution_date") @db.Date
  createdAt        DateTime             @default(now()) @map("created_at")

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  month Month @relation(fields: [monthId], references: [id])

  @@index([goalId])
  @@index([monthId], map: "goal_contributions_month_id_idx")
  @@map("goal_contributions")
}

model Alert {
  id         BigInt        @id @default(autoincrement())
  userId     BigInt        @map("user_id")
  monthId    BigInt        @map("month_id")
  type       String        @db.VarChar(60)
  severity   AlertSeverity @default(info)
  message    String        @db.VarChar(255)
  createdAt  DateTime      @default(now()) @map("created_at")
  readAt     DateTime?     @map("read_at")
  resolvedAt DateTime?     @map("resolved_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  month Month @relation(fields: [monthId], references: [id], onDelete: Cascade)

  @@unique([userId, monthId, type])
  @@index([userId, monthId])
  @@map("alerts")
}

model FinancialHealthScore {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt   @map("user_id")
  monthId       BigInt   @unique @map("month_id")
  score         Int      @db.SmallInt
  breakdownJson Json     @map("breakdown_json")
  createdAt     DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  month Month @relation(fields: [monthId], references: [id], onDelete: Cascade)

  @@map("financial_health_scores")
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @map("user_id")
  entity       String   @db.VarChar(60)
  entityId     BigInt   @map("entity_id")
  action       String   @db.VarChar(40)
  oldValueJson Json?    @map("old_value_json")
  newValueJson Json?    @map("new_value_json")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entity, entityId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_log")
}

model Simulation {
  id          BigInt         @id @default(autoincrement())
  userId      BigInt         @map("user_id")
  type        SimulationType
  name        String         @db.VarChar(160)
  inputJson   Json           @map("input_json")
  monthsAhead Int            @default(12) @map("months_ahead") @db.SmallInt
  createdAt   DateTime       @default(now()) @map("created_at")

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  results SimulationResult[]

  @@index([userId])
  @@map("simulations")
}

model SimulationResult {
  id           BigInt   @id @default(autoincrement())
  simulationId BigInt   @map("simulation_id")
  monthIndex   Int      @map("month_index") @db.SmallInt
  month        Int      @db.SmallInt
  year         Int      @db.SmallInt
  baselineNet  Decimal  @map("baseline_net") @db.Decimal(12, 2)
  scenarioNet  Decimal  @map("scenario_net") @db.Decimal(12, 2)
  difference   Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, monthIndex])
  @@map("simulation_results")
}

model DashboardPreference {
  userId              BigInt   @id @map("user_id")
  showSummaryChart    Boolean  @default(true) @map("show_summary_chart")
  showAlerts          Boolean  @default(true) @map("show_alerts")
  showRecommendations Boolean  @default(true) @map("show_recommendations")
  showCards           Boolean  @default(true) @map("show_cards")
  showProjections     Boolean  @default(true) @map("show_projections")
  showCategoryChart   Boolean  @default(true) @map("show_category_chart")
  showGoals           Boolean  @default(true) @map("show_goals")
  summaryChart        String   @default("bars") @map("summary_chart") @db.VarChar(20)
  projectionView      String   @default("area") @map("projection_view") @db.VarChar(20)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dashboard_preferences")
}

/// Configuração de automações do usuário (uma linha por usuário).
/// Tudo é opcional e desligado por padrão — ligar não altera dados, só
/// habilita ações que rodam ao fechar o mês ou no botão "Rodar agora".
model AutomationSetting {
  id        BigInt @id @default(autoincrement())
  userId    BigInt @unique @map("user_id")

  /// Ao fechar o mês, pagar o que vencer (dívidas, contas, faturas) se houver saldo.
  payDuesOnClose Boolean @default(false) @map("pay_dues_on_close")
  /// Método usado nos pagamentos automáticos: 'debit' (saldo) ou 'cash'.
  payDuesMethod  String  @default("debit") @map("pay_dues_method") @db.VarChar(10)

  /// Quais grupos entram no pagamento automático. Permite, por exemplo,
  /// quitar dívidas e contas mas deixar a fatura do cartão para decidir na mão.
  payDebts    Boolean @default(true) @map("pay_debts")
  payBills    Boolean @default(true) @map("pay_bills")
  payInvoices Boolean @default(true) @map("pay_invoices")
  /// Adiantar faturas que ainda NÃO fecharam. Desligado por padrão: uma
  /// fatura aberta segue recebendo compras, então pagá-la antes do
  /// fechamento quita uma conta que ainda vai crescer.
  payOpenInvoices Boolean @default(false) @map("pay_open_invoices")

  /// Piso de segurança: a automação nunca deixa o saldo abaixo deste valor.
  /// Vale tanto para os pagamentos quanto para o quanto vai para a reserva.
  minimumBalance Decimal @default(0) @map("minimum_balance") @db.Decimal(12, 2)

  /// Ao fechar o mês, guardar parte da sobra numa caixinha de reserva.
  saveLeftoverOnClose Boolean @default(false) @map("save_leftover_on_close")
  /// Como calcular quanto guardar: 'percent' (% da sobra) ou 'fixed' (valor fixo, se couber).
  saveLeftoverType    String  @default("percent") @map("save_leftover_type") @db.VarChar(10)
  /// Valor da regra acima (porcentagem 0-100, ou valor fixo em reais).
  saveLeftoverValue   Decimal @default(0) @map("save_leftover_value") @db.Decimal(12, 2)
  /// Caixinha destino (se nula, usa a caixinha principal).
  saveLeftoverBucketId BigInt? @map("save_leftover_bucket_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucket SavingsBucket? @relation(fields: [saveLeftoverBucketId], references: [id], onDelete: SetNull)

  @@map("automation_settings")
}

model BillingPurchase {
  id                BigInt                 @id @default(autoincrement())
  userId            BigInt                 @map("user_id")
  checkoutSessionId String                 @unique @map("checkout_session_id") @db.VarChar(255)
  paymentIntentId   String?                @unique @map("payment_intent_id") @db.VarChar(255)
  customerId        String?                @map("customer_id") @db.VarChar(255)
  priceId           String                 @map("price_id") @db.VarChar(255)
  amountTotal       Int?                   @map("amount_total")
  currency          String?                @db.VarChar(12)
  status            BillingPurchaseStatus  @default(pending)
  paidAt            DateTime?              @map("paid_at")
  refundedAt        DateTime?              @map("refunded_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("billing_purchases")
}

/// Histórico imutável de snapshots. Um snapshot de mês fechado nunca é
/// sobrescrito silenciosamente: a versão anterior é arquivada aqui com o
/// motivo da reconstrução, permitindo auditoria e migração controlada.
model MonthSnapshotVersion {
  id        BigInt   @id @default(autoincrement())
  monthId   BigInt   @map("month_id")
  version   Int      @db.SmallInt
  snapshot  Json
  reason    String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")

  month Month @relation(fields: [monthId], references: [id], onDelete: Cascade)

  @@index([monthId, createdAt(sort: Desc)], map: "month_snapshot_versions_month_id_created_at_idx")
  @@map("month_snapshot_versions")
}

model StripeEvent {
  id          BigInt   @id @default(autoincrement())
  eventId     String   @unique @map("event_id") @db.VarChar(255)
  type        String   @db.VarChar(120)
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("stripe_events")
}

